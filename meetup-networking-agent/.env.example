# ---------- Agent identity ----------
AGENT_NAME=meetup-networking-agent
AGENT_SEED=replace-with-a-long-random-string
AGENT_PORT=8000
AGENT_ENDPOINT=http://127.0.0.1:8000/submit

# ---------- Storage ----------
# Must include the pgvector extension. The migration in agents-db/ creates it.
DATABASE_URL=postgresql://meetup:meetup@localhost:5432/meetup
DB_POOL_MIN=1
DB_POOL_MAX=10

# ---------- LinkedIn OAuth ----------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://your-host.example.com/oauth/linkedin/callback

# ---------- GitHub OAuth ----------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://your-host.example.com/oauth/github/callback

# ---------- Embeddings ----------
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ---------- LLM (used for match explanations + refinement parsing) ----------
ASI1_API_KEY=
ASI1_MODEL=asi1-mini
ASI1_API_BASE=https://api.asi1.ai/v1

# ---------- Observability ----------
SENTRY_DSN=
ENVIRONMENT=production
LOG_LEVEL=INFO

# ---------- Health probes ----------
HEALTH_PORT=8080

# ---------- Privacy / retention ----------
RETENTION_DAYS=30
SESSION_SECRET=replace-with-a-32-byte-random-string
